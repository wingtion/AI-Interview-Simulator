{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secret — supplied at runtime, NOT committed.
  //   Local dev: set in appsettings.Development.json (gitignored) or user-secrets.
  //   Production (Fly.io): `fly secrets set GroqApiKey=...`
  "GroqApiKey": "",

  // Comma-separated list of allowed browser origins for CORS.
  //   Production: set the Netlify URL via `fly secrets set AllowedOrigins=https://your-site.netlify.app`
  // localhost:5173 is always allowed for local dev (see Program.cs).
  "AllowedOrigins": ""
}
